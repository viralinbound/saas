NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your-key"

# Required to apply schema: Supabase Dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Optional: for admin/seed operations (Dashboard → API Keys → Secret key)
SUPABASE_SECRET_KEY="sb_secret_your-key"
